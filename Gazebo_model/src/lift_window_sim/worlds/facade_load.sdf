<?xml version="1.0"?>
<!-- Facade in the MATLAB world frame (kinematics_model.m / window_washer_planner.m):
     glass in the plane y = 0 for 0 <= x, z <= 10 m, 100 panes of 1 x 1 m with 3.6 cm wide frames
     standing 6 cm out from the glass. The lift pivot is at (-3, -2, 1.5) m.
     The water-jet reaction force (R6, 40 N) acts on the nozzle along the jet axis, away from the wall
     (world -y, the jet direction when the nozzle sprays straight at the glass). -->
<sdf version="1.6">
  <world name="facade">
    <gravity>0 0 -9.81</gravity>
    <physics name="physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
      <engine><filename>gz-physics-bullet-featherstone-plugin</filename></engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <!-- Force in world coordinates (ApplyLinkWrench), applied to the nozzle link -->
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench">
      <persistent>
        <entity_name>lift_window::nozzle</entity_name>
        <entity_type>link</entity_type>
        <force>0 -40 0</force>
      </persistent>
    </plugin>
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.78 0.85 0.93 1</background>
      <shadows>false</shadows>
    </scene>
    <light type="directional" name="sun">
      <pose>0 -10 12 0 0 0</pose>
      <direction>0.3 0.5 -1</direction>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <cast_shadows>false</cast_shadows>
    </light>
    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision"><geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry></collision>
        <visual name="ground_visual"><geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material><ambient>0.45 0.48 0.46 1</ambient><diffuse>0.45 0.48 0.46 1</diffuse></material></visual>
      </link>
    </model>
    <model name="facade">
      <static>true</static>
      <link name="facade_link">
        <visual name="wall_visual"><pose>5 0.11 5 0 0 0</pose><geometry><box><size>10 0.2 10</size></box></geometry><material><ambient>0.40 0.65 0.75 1</ambient><diffuse>0.40 0.65 0.75 1</diffuse></material></visual>
        <collision name="wall_collision"><pose>5 0.11 5 0 0 0</pose><geometry><box><size>10 0.2 10</size></box></geometry></collision>
        <visual name="glass_visual"><pose>5 0.005 5 0 0 0</pose><geometry><box><size>10 0.01 10</size></box></geometry><material><ambient>0.16 0.30 0.40 1</ambient><diffuse>0.16 0.30 0.40 1</diffuse></material></visual>
        <collision name="glass_collision"><pose>5 0.005 5 0 0 0</pose><geometry><box><size>10 0.01 10</size></box></geometry></collision>
        <visual name="frame_v0_visual"><pose>0 -0.03 5 0 0 0</pose><geometry><box><size>0.036 0.06 10.036</size></box></geometry><material><ambient>0.8 0.82 0.84 1</ambient><diffuse>0.8 0.82 0.84 1</diffuse></material></visual>
        <collision name="frame_v0_collision"><pose>0 -0.03 5 0 0 0</pose><geometry><box><size>0.036 0.06 10.036</size></box></geometry></collision>
        <visual name="frame_h0_visual"><pose>5 -0.03 0 0 0 0</pose><geometry><box><size>10.036 0.06 0.036</size></box></geometry><material><ambient>0.8 0.82 0.84 1</ambient><diffuse>0.8 0.82 0.84 1</diffuse></material></visual>
        <collision name="frame_h0_collision"><pose>5 -0.03 0 0 0 0</pose><geometry><box><size>10.036 0.06 0.036</size></box></geometry></collision>
        <visual name="frame_v1_visual"><pose>1 -0.03 5 0 0 0</pose><geometry><box><size>0.036 0.06 10.036</size></box></geometry><material><ambient>0.8 0.82 0.84 1</ambient><diffuse>0.8 0.82 0.84 1</diffuse></material></visual>
        <collision name="frame_v1_collision"><pose>1 -0.03 5 0 0 0</pose><geometry><box><size>0.036 0.06 10.036</size></box></geometry></collision>
        <visual name="frame_h1_visual"><pose>5 -0.03 1 0 0 0</pose><geometry><box><size>10.036 0.06 0.036</size></box></geometry><material><ambient>0.8 0.82 0.84 1</ambient><diffuse>0.8 0.82 0.84 1</diffuse></material></visual>
        <collision name="frame_h1_collision"><pose>5 -0.03 1 0 0 0</pose><geometry><box><size>10.036 0.06 0.036</size></box></geometry></collision>
        <visual name="frame_v2_visual"><pose>2 -0.03 5 0 0 0</pose><geometry><box><size>0.036 0.06 10.036</size></box></geometry><material><ambient>0.8 0.82 0.84 1</ambient><diffuse>0.8 0.82 0.84 1</diffuse></material></visual>
        <collision name="frame_v2_collision"><pose>2 -0.03 5 0 0 0</pose><geometry><box><size>0.036 0.06 10.036</size></box></geometry></collision>
        <visual name="frame_h2_visual"><pose>5 -0.03 2 0 0 0</pose><geometry><box><size>10.036 0.06 0.036</size></box></geometry><material><ambient>0.8 0.82 0.84 1</ambient><diffuse>0.8 0.82 0.84 1</diffuse></material></visual>
        <collision name="frame_h2_collision"><pose>5 -0.03 2 0 0 0</pose><geometry><box><size>10.036 0.06 0.036</size></box></geometry></collision>
        <visual name="frame_v3_visual"><pose>3 -0.03 5 0 0 0</pose><geometry><box><size>0.036 0.06 10.036</size></box></geometry><material><ambient>0.8 0.82 0.84 1</ambient><diffuse>0.8 0.82 0.84 1</diffuse></material></visual>
        <collision name="frame_v3_collision"><pose>3 -0.03 5 0 0 0</pose><geometry><box><size>0.036 0.06 10.036</size></box></geometry></collision>
        <visual name="frame_h3_visual"><pose>5 -0.03 3 0 0 0</pose><geometry><box><size>10.036 0.06 0.036</size></box></geometry><material><ambient>0.8 0.82 0.84 1</ambient><diffuse>0.8 0.82 0.84 1</diffuse></material></visual>
        <collision name="frame_h3_collision"><pose>5 -0.03 3 0 0 0</pose><geometry><box><size>10.036 0.06 0.036</size></box></geometry></collision>
        <visual name="frame_v4_visual"><pose>4 -0.03 5 0 0 0</pose><geometry><box><size>0.036 0.06 10.036</size></box></geometry><material><ambient>0.8 0.82 0.84 1</ambient><diffuse>0.8 0.82 0.84 1</diffuse></material></visual>
        <collision name="frame_v4_collision"><pose>4 -0.03 5 0 0 0</pose><geometry><box><size>0.036 0.06 10.036</size></box></geometry></collision>
        <visual name="frame_h4_visual"><pose>5 -0.03 4 0 0 0</pose><geometry><box><size>10.036 0.06 0.036</size></box></geometry><material><ambient>0.8 0.82 0.84 1</ambient><diffuse>0.8 0.82 0.84 1</diffuse></material></visual>
        <collision name="frame_h4_collision"><pose>5 -0.03 4 0 0 0</pose><geometry><box><size>10.036 0.06 0.036</size></box></geometry></collision>
        <visual name="frame_v5_visual"><pose>5 -0.03 5 0 0 0</pose><geometry><box><size>0.036 0.06 10.036</size></box></geometry><material><ambient>0.8 0.82 0.84 1</ambient><diffuse>0.8 0.82 0.84 1</diffuse></material></visual>
        <collision name="frame_v5_collision"><pose>5 -0.03 5 0 0 0</pose><geometry><box><size>0.036 0.06 10.036</size></box></geometry></collision>
        <visual name="frame_h5_visual"><pose>5 -0.03 5 0 0 0</pose><geometry><box><size>10.036 0.06 0.036</size></box></geometry><material><ambient>0.8 0.82 0.84 1</ambient><diffuse>0.8 0.82 0.84 1</diffuse></material></visual>
        <collision name="frame_h5_collision"><pose>5 -0.03 5 0 0 0</pose><geometry><box><size>10.036 0.06 0.036</size></box></geometry></collision>
        <visual name="frame_v6_visual"><pose>6 -0.03 5 0 0 0</pose><geometry><box><size>0.036 0.06 10.036</size></box></geometry><material><ambient>0.8 0.82 0.84 1</ambient><diffuse>0.8 0.82 0.84 1</diffuse></material></visual>
        <collision name="frame_v6_collision"><pose>6 -0.03 5 0 0 0</pose><geometry><box><size>0.036 0.06 10.036</size></box></geometry></collision>
        <visual name="frame_h6_visual"><pose>5 -0.03 6 0 0 0</pose><geometry><box><size>10.036 0.06 0.036</size></box></geometry><material><ambient>0.8 0.82 0.84 1</ambient><diffuse>0.8 0.82 0.84 1</diffuse></material></visual>
        <collision name="frame_h6_collision"><pose>5 -0.03 6 0 0 0</pose><geometry><box><size>10.036 0.06 0.036</size></box></geometry></collision>
        <visual name="frame_v7_visual"><pose>7 -0.03 5 0 0 0</pose><geometry><box><size>0.036 0.06 10.036</size></box></geometry><material><ambient>0.8 0.82 0.84 1</ambient><diffuse>0.8 0.82 0.84 1</diffuse></material></visual>
        <collision name="frame_v7_collision"><pose>7 -0.03 5 0 0 0</pose><geometry><box><size>0.036 0.06 10.036</size></box></geometry></collision>
        <visual name="frame_h7_visual"><pose>5 -0.03 7 0 0 0</pose><geometry><box><size>10.036 0.06 0.036</size></box></geometry><material><ambient>0.8 0.82 0.84 1</ambient><diffuse>0.8 0.82 0.84 1</diffuse></material></visual>
        <collision name="frame_h7_collision"><pose>5 -0.03 7 0 0 0</pose><geometry><box><size>10.036 0.06 0.036</size></box></geometry></collision>
        <visual name="frame_v8_visual"><pose>8 -0.03 5 0 0 0</pose><geometry><box><size>0.036 0.06 10.036</size></box></geometry><material><ambient>0.8 0.82 0.84 1</ambient><diffuse>0.8 0.82 0.84 1</diffuse></material></visual>
        <collision name="frame_v8_collision"><pose>8 -0.03 5 0 0 0</pose><geometry><box><size>0.036 0.06 10.036</size></box></geometry></collision>
        <visual name="frame_h8_visual"><pose>5 -0.03 8 0 0 0</pose><geometry><box><size>10.036 0.06 0.036</size></box></geometry><material><ambient>0.8 0.82 0.84 1</ambient><diffuse>0.8 0.82 0.84 1</diffuse></material></visual>
        <collision name="frame_h8_collision"><pose>5 -0.03 8 0 0 0</pose><geometry><box><size>10.036 0.06 0.036</size></box></geometry></collision>
        <visual name="frame_v9_visual"><pose>9 -0.03 5 0 0 0</pose><geometry><box><size>0.036 0.06 10.036</size></box></geometry><material><ambient>0.8 0.82 0.84 1</ambient><diffuse>0.8 0.82 0.84 1</diffuse></material></visual>
        <collision name="frame_v9_collision"><pose>9 -0.03 5 0 0 0</pose><geometry><box><size>0.036 0.06 10.036</size></box></geometry></collision>
        <visual name="frame_h9_visual"><pose>5 -0.03 9 0 0 0</pose><geometry><box><size>10.036 0.06 0.036</size></box></geometry><material><ambient>0.8 0.82 0.84 1</ambient><diffuse>0.8 0.82 0.84 1</diffuse></material></visual>
        <collision name="frame_h9_collision"><pose>5 -0.03 9 0 0 0</pose><geometry><box><size>10.036 0.06 0.036</size></box></geometry></collision>
        <visual name="frame_v10_visual"><pose>10 -0.03 5 0 0 0</pose><geometry><box><size>0.036 0.06 10.036</size></box></geometry><material><ambient>0.8 0.82 0.84 1</ambient><diffuse>0.8 0.82 0.84 1</diffuse></material></visual>
        <collision name="frame_v10_collision"><pose>10 -0.03 5 0 0 0</pose><geometry><box><size>0.036 0.06 10.036</size></box></geometry></collision>
        <visual name="frame_h10_visual"><pose>5 -0.03 10 0 0 0</pose><geometry><box><size>10.036 0.06 0.036</size></box></geometry><material><ambient>0.8 0.82 0.84 1</ambient><diffuse>0.8 0.82 0.84 1</diffuse></material></visual>
        <collision name="frame_h10_collision"><pose>5 -0.03 10 0 0 0</pose><geometry><box><size>10.036 0.06 0.036</size></box></geometry></collision>
      </link>
    </model>
    <model name="top_strip_guide">
      <static>true</static>
      <link name="guide">
        <visual name="lower_visual"><pose>5 -0.065 9 0 0 0</pose><geometry><box><size>10 0.006 0.02</size></box></geometry><material><ambient>0.2 0.95 0.4 1</ambient><diffuse>0.2 0.95 0.4 1</diffuse><emissive>0.2 0.95 0.4 1</emissive></material></visual>
        <visual name="upper_visual"><pose>5 -0.065 10 0 0 0</pose><geometry><box><size>10 0.006 0.02</size></box></geometry><material><ambient>0.2 0.95 0.4 1</ambient><diffuse>0.2 0.95 0.4 1</diffuse><emissive>0.2 0.95 0.4 1</emissive></material></visual>
        <visual name="left_visual"><pose>0 -0.065 9.5 0 0 0</pose><geometry><box><size>0.02 0.006 1</size></box></geometry><material><ambient>0.2 0.95 0.4 1</ambient><diffuse>0.2 0.95 0.4 1</diffuse><emissive>0.2 0.95 0.4 1</emissive></material></visual>
        <visual name="right_visual"><pose>10 -0.065 9.5 0 0 0</pose><geometry><box><size>0.02 0.006 1</size></box></geometry><material><ambient>0.2 0.95 0.4 1</ambient><diffuse>0.2 0.95 0.4 1</diffuse><emissive>0.2 0.95 0.4 1</emissive></material></visual>
      </link>
    </model>
  </world>
</sdf>

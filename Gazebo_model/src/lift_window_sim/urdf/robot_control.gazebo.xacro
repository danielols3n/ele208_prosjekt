<?xml version="1.0"?>
<!-- ros2_control og Gazebo-plugin. Alle ni leddene posisjonsstyres; teleskoptrinnene
     stage2-4 følger boom_extension og har bare tilstand. Startverdiene er første
     punkt i trajectories/demo.csv. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="boom_yaw">
      <command_interface name="position" />
      <state_interface name="position">
        <param name="initial_value">0.3805063771</param>
      </state_interface>
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="boom_pitch">
      <command_interface name="position" />
      <state_interface name="position">
        <param name="initial_value">2.734808508</param>
      </state_interface>
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="boom_extension">
      <command_interface name="position" />
      <state_interface name="position">
        <param name="initial_value">1.141598638</param>
      </state_interface>
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="stage2_slide">
      <command_interface name="position" />
      <state_interface name="position">
        <param name="initial_value">1.141598638</param>
      </state_interface>
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="stage3_slide">
      <command_interface name="position" />
      <state_interface name="position">
        <param name="initial_value">1.141598638</param>
      </state_interface>
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="stage4_slide">
      <command_interface name="position" />
      <state_interface name="position">
        <param name="initial_value">1.141598638</param>
      </state_interface>
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="arm_swivel">
      <command_interface name="position" />
      <state_interface name="position">
        <param name="initial_value">1.164012181</param>
      </state_interface>
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="arm_joint_1">
      <command_interface name="position" />
      <state_interface name="position">
        <param name="initial_value">1.116088537</param>
      </state_interface>
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="arm_joint_2">
      <command_interface name="position" />
      <state_interface name="position">
        <param name="initial_value">0.6810421657</param>
      </state_interface>
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="arm_joint_3">
      <command_interface name="position" />
      <state_interface name="position">
        <param name="initial_value">-2.631580299</param>
      </state_interface>
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="arm_joint_4">
      <command_interface name="position" />
      <state_interface name="position">
        <param name="initial_value">-1.609945452</param>
      </state_interface>
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="arm_joint_5">
      <command_interface name="position" />
      <state_interface name="position">
        <param name="initial_value">1.150752587</param>
      </state_interface>
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find lift_window_sim)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>

<?xml version="1.0"?>
<!-- Vindusvaskeroboten: teleskopbomlift, plate, femleddet UR5-inspirert arm og dyse.
     Kinematikken følger DH-tabellen i rapporten (Tabell 3.1.1) og kinematics_model.m:
       - leddene roterer om z-aksen i forrige DH-ramme, og den faste delen av hver
         DH-rad (Trans(a,0,d)*Rot_x(alpha)) står i origin til neste ledd
       - liftbasen (bommens dreiepunkt) står i (-3, -2, 1.5) m i verden
       - bommen har fem seksjoner på 3.6 m og går fra 3.6 til 15 m:
         d3 = L_min + 4*boom_extension, der boom_extension er uttrekket per trinn
       - verktøy: 0.0823 m UR5-flens + 0.15 m dyse langs z9
     Leddvinklene i Gazebo er dermed de samme som i MATLAB-modellen.
     Massene og tyngdepunktene er de samme som i kinematics_model.m (rapporten, 3.4.1). -->
<robot name="lift_window" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find lift_window_sim)/urdf/inertial_macros.urdf.xacro" />
  <xacro:include filename="$(find lift_window_sim)/urdf/robot_control.gazebo.xacro" />

  <!-- Geometri fra kinematics_model.m -->
  <xacro:property name="base_x" value="-3.0" />
  <xacro:property name="base_y" value="-2.0" />
  <xacro:property name="base_z" value="1.5" />
  <xacro:property name="L_min" value="3.6" />          <!-- innskjøvet bom = seksjonslengde [m] -->
  <xacro:property name="L_max" value="15.0" />         <!-- utskjøvet bom [m] -->
  <xacro:property name="n_trinn" value="4" />          <!-- teleskoptrinn i tillegg til ytre seksjon -->
  <xacro:property name="trinn_maks" value="${(L_max - L_min)/n_trinn}" />
  <xacro:property name="e_start" value="1.141598638" />  <!-- boom_extension i startposen (demo.csv) -->
  <xacro:property name="q2_min" value="${75*pi/180}" /> <!-- bommen maks 15 grader under horisontal -->
  <xacro:property name="d1" value="0.089159" />
  <xacro:property name="a2" value="-0.425" />
  <xacro:property name="a3" value="-0.39225" />
  <xacro:property name="d4" value="0.10915" />
  <xacro:property name="d5" value="0.09465" />
  <xacro:property name="L_flens" value="0.0823" />
  <xacro:property name="L_dyse" value="0.15" />

  <material name="blue"><color rgba="0.18 0.43 0.65 1" /></material>
  <material name="orange"><color rgba="0.95 0.60 0.08 1" /></material>
  <material name="grey"><color rgba="0.75 0.77 0.80 1" /></material>
  <material name="red"><color rgba="0.85 0.15 0.10 1" /></material>
  <material name="black"><color rgba="0.10 0.10 0.12 1" /></material>

  <!-- ================= Mobil plattform (står fast mens armen vasker) ================= -->
  <link name="world" />
  <link name="base_footprint" />

  <joint name="world_fixed" type="fixed">
    <parent link="world" />
    <child link="base_footprint" />
    <origin xyz="${base_x - 0.7} ${base_y} 0" rpy="0 0 0" />
  </joint>

  <joint name="footprint_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 0.75" rpy="0 0 0" />
  </joint>

  <link name="base_link">
    <xacro:inertial_box mass="500" x="2.2" y="1.6" z="0.6">
      <origin xyz="0 0 0" rpy="0 0 0" />
    </xacro:inertial_box>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><box size="2.2 1.6 0.6" /></geometry>
      <material name="blue" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><box size="2.2 1.6 0.6" /></geometry>
    </collision>
    <visual>
      <origin xyz="0.95 0.92 -0.45" rpy="${pi/2} 0 0" />
      <geometry><cylinder radius="0.3" length="0.24" /></geometry>
      <material name="black" />
    </visual>
    <visual>
      <origin xyz="0.95 -0.92 -0.45" rpy="${pi/2} 0 0" />
      <geometry><cylinder radius="0.3" length="0.24" /></geometry>
      <material name="black" />
    </visual>
    <visual>
      <origin xyz="-0.95 0.92 -0.45" rpy="${pi/2} 0 0" />
      <geometry><cylinder radius="0.3" length="0.24" /></geometry>
      <material name="black" />
    </visual>
    <visual>
      <origin xyz="-0.95 -0.92 -0.45" rpy="${pi/2} 0 0" />
      <geometry><cylinder radius="0.3" length="0.24" /></geometry>
      <material name="black" />
    </visual>
  </link>

  <!-- ================= Lift: ledd 1-4 ================= -->
  <joint name="boom_yaw" type="revolute">
    <parent link="base_link" />
    <child link="turret" />
    <origin xyz="0.7 0 0.75" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="${-pi}" upper="${pi}" velocity="0.15" effort="30000" />
    <dynamics damping="3" friction="0.0" />
  </joint>

  <link name="turret">
    <!-- dreiekrans 40 kg, i dreiepunktet -->
    <xacro:inertial_point mass="40">
      <origin xyz="0 0 0" rpy="0 0 0" />
    </xacro:inertial_point>
    <visual>
      <origin xyz="0 0 -0.15" rpy="0 0 0" />
      <geometry><box size="0.45 0.45 0.6" /></geometry>
      <material name="blue" />
    </visual>
    <collision>
      <origin xyz="0 0 -0.15" rpy="0 0 0" />
      <geometry><box size="0.45 0.45 0.6" /></geometry>
    </collision>
  </link>

  <joint name="boom_pitch" type="revolute">
    <parent link="turret" />
    <child link="boom_outer" />
    <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="${q2_min}" upper="${pi}" velocity="0.12" effort="40000" />
    <dynamics damping="3" friction="0.0" />
  </joint>

  <link name="boom_outer">
    <!-- seksjon 1: 66.5 kg, tyngdepunkt midt på seksjonen (bommen ligger langs -y her) -->
    <xacro:inertial_point mass="66.5">
      <origin xyz="0 -1.8 0" rpy="0 0 0" />
    </xacro:inertial_point>
    <visual>
      <origin xyz="0 ${-L_min/2} 0" rpy="0 0 0" />
      <geometry><box size="0.2 ${L_min} 0.35" /></geometry>
      <material name="orange" />
    </visual>
    <collision>
      <origin xyz="0 ${-L_min/2} 0" rpy="0 0 0" />
      <geometry><box size="0.2 ${L_min} 0.35" /></geometry>
    </collision>
  </link>

  <!-- Teleskopet: alle fire trinn posisjonsstyres med samme uttrekk (ingen mimic, som Gazebo ikke klarte). Rammene har z langs bommen. -->
  <joint name="boom_extension" type="prismatic">
    <parent link="boom_outer" />
    <child link="stage1" />
    <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="0" upper="${trinn_maks}" velocity="0.12" effort="15000" />
    <dynamics damping="3" friction="0.0" />
  </joint>

  <link name="stage1">
    <!-- 20 kg flyttet hit fra stage4 (0.5 kg var for lett for Gazebo, trinnet sto fast).
         Tyngdepunktet ligger i samme punkt som stage4 sitt i startposen, så momentet er uendret der. -->
    <xacro:inertial_point mass="20">
      <origin xyz="0 0 ${(4-1)*e_start - 3}" rpy="0 0 0" />
    </xacro:inertial_point>
    <visual>
      <origin xyz="0 0 ${L_min/2}" rpy="0 0 0" />
      <geometry><box size="0.175 0.315 ${L_min}" /></geometry>
      <material name="orange" />
    </visual>
    <collision>
      <origin xyz="0 0 ${L_min/2}" rpy="0 0 0" />
      <geometry><box size="0.175 0.315 ${L_min}" /></geometry>
    </collision>
  </link>

  <joint name="stage2_slide" type="prismatic">
    <parent link="stage1" />
    <child link="stage2" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="0" upper="${trinn_maks}" velocity="0.12" effort="15000" />
    <dynamics damping="3" friction="0.0" />
  </joint>

  <link name="stage2">
    <!-- 20 kg flyttet hit fra stage4 (0.5 kg var for lett for Gazebo, trinnet sto fast).
         Tyngdepunktet ligger i samme punkt som stage4 sitt i startposen, så momentet er uendret der. -->
    <xacro:inertial_point mass="20">
      <origin xyz="0 0 ${(4-2)*e_start - 3}" rpy="0 0 0" />
    </xacro:inertial_point>
    <visual>
      <origin xyz="0 0 ${L_min/2}" rpy="0 0 0" />
      <geometry><box size="0.15 0.28 ${L_min}" /></geometry>
      <material name="orange" />
    </visual>
    <collision>
      <origin xyz="0 0 ${L_min/2}" rpy="0 0 0" />
      <geometry><box size="0.15 0.28 ${L_min}" /></geometry>
    </collision>
  </link>

  <joint name="stage3_slide" type="prismatic">
    <parent link="stage2" />
    <child link="stage3" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="0" upper="${trinn_maks}" velocity="0.12" effort="15000" />
    <dynamics damping="3" friction="0.0" />
  </joint>

  <link name="stage3">
    <!-- 20 kg flyttet hit fra stage4 (0.5 kg var for lett for Gazebo, trinnet sto fast).
         Tyngdepunktet ligger i samme punkt som stage4 sitt i startposen, så momentet er uendret der. -->
    <xacro:inertial_point mass="20">
      <origin xyz="0 0 ${(4-3)*e_start - 3}" rpy="0 0 0" />
    </xacro:inertial_point>
    <visual>
      <origin xyz="0 0 ${L_min/2}" rpy="0 0 0" />
      <geometry><box size="0.125 0.245 ${L_min}" /></geometry>
      <material name="orange" />
    </visual>
    <collision>
      <origin xyz="0 0 ${L_min/2}" rpy="0 0 0" />
      <geometry><box size="0.125 0.245 ${L_min}" /></geometry>
    </collision>
  </link>

  <joint name="stage4_slide" type="prismatic">
    <parent link="stage3" />
    <child link="stage4" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="0" upper="${trinn_maks}" velocity="0.12" effort="15000" />
    <dynamics damping="3" friction="0.0" />
  </joint>

  <link name="stage4">
    <!-- seksjon 2-5 + halve slangen: 201.8 kg, 6.6 m bak tuppen (som i MATLAB).
         Stage1-3 har 20 kg hver, som er trukket fra her (201.8 - 60 = 141.8 kg). -->
    <xacro:inertial_point mass="141.8">
      <origin xyz="0 0 -3" rpy="0 0 0" />
    </xacro:inertial_point>
    <visual>
      <origin xyz="0 0 ${L_min/2}" rpy="0 0 0" />
      <geometry><box size="0.1 0.21 ${L_min}" /></geometry>
      <material name="orange" />
    </visual>
    <collision>
      <origin xyz="0 0 ${L_min/2}" rpy="0 0 0" />
      <geometry><box size="0.1 0.21 ${L_min}" /></geometry>
    </collision>
  </link>

  <!-- Platen holdes i vater: arm_swivel = boom_pitch - pi/2 -->
  <joint name="arm_swivel" type="revolute">
    <parent link="stage4" />
    <child link="plate" />
    <origin xyz="0 0 ${L_min}" rpy="${pi/2} 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-0.3" upper="1.6" velocity="0.5" effort="800" />
    <dynamics damping="0.1" friction="0.0" />
  </joint>

  <link name="plate">
    <!-- plate 10 kg + kamera 1 kg + halve slangen 10 kg = 21 kg -->
    <xacro:inertial_point mass="21">
      <origin xyz="-0.0142857 -0.0261905 0" rpy="0 0 0" />
    </xacro:inertial_point>
    <visual>
      <origin xyz="0 -0.005 0" rpy="0 0 0" />
      <geometry><box size="0.5 0.01 0.4" /></geometry>
      <material name="grey" />
    </visual>
    <collision>
      <origin xyz="0 -0.005 0" rpy="0 0 0" />
      <geometry><box size="0.5 0.01 0.4" /></geometry>
    </collision>
    <!-- 3D-kamera 0.3 m under origo i ramme 4 -->
    <visual>
      <origin xyz="-0.3 0.03 0" rpy="0 0 0" />
      <geometry><box size="0.06 0.05 0.12" /></geometry>
      <material name="black" />
    </visual>
  </link>

  <!-- ================= Robotarm: ledd 5-9 (UR5 uten siste håndleddsledd) ================= -->
  <joint name="arm_joint_1" type="revolute">
    <parent link="plate" />
    <child link="arm1" />
    <origin xyz="0 0 0" rpy="${-pi/2} 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="${-2*pi}" upper="${2*pi}" velocity="${pi}" effort="400" />
    <dynamics damping="0.1" friction="0.0" />
  </joint>

  <link name="arm1">
    <!-- UR5 ledd 1: 3.7 kg -->
    <xacro:inertial_point mass="3.7">
      <origin xyz="0 -0.00193 0.063549" rpy="0 0 0" />
    </xacro:inertial_point>
    <visual>
      <origin xyz="0 0 ${d1/2}" rpy="0 0 0" />
      <geometry><box size="0.14 0.14 ${d1}" /></geometry>
      <material name="blue" />
    </visual>
    <collision>
      <origin xyz="0 0 ${d1/2}" rpy="0 0 0" />
      <geometry><box size="0.14 0.14 ${d1}" /></geometry>
    </collision>
  </link>

  <joint name="arm_joint_2" type="revolute">
    <parent link="arm1" />
    <child link="arm2" />
    <origin xyz="0 0 ${d1}" rpy="${pi/2} 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="${-2*pi}" upper="${2*pi}" velocity="${pi}" effort="600" />
    <dynamics damping="0.1" friction="0.0" />
  </joint>

  <link name="arm2">
    <!-- UR5 ledd 2: 8.393 kg -->
    <xacro:inertial_point mass="8.393">
      <origin xyz="-0.2125 0 0.11336" rpy="0 0 0" />
    </xacro:inertial_point>
    <visual>
      <origin xyz="${a2/2} 0 0" rpy="0 0 0" />
      <geometry><box size="${-a2} 0.12 0.12" /></geometry>
      <material name="blue" />
    </visual>
    <collision>
      <origin xyz="${a2/2} 0 0" rpy="0 0 0" />
      <geometry><box size="${-a2} 0.12 0.12" /></geometry>
    </collision>
  </link>

  <joint name="arm_joint_3" type="revolute">
    <parent link="arm2" />
    <child link="arm3" />
    <origin xyz="${a2} 0 0" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="${-2*pi}" upper="${2*pi}" velocity="${pi}" effort="400" />
    <dynamics damping="0.1" friction="0.0" />
  </joint>

  <link name="arm3">
    <!-- UR5 ledd 3: 2.33 kg -->
    <xacro:inertial_point mass="2.33">
      <origin xyz="-0.24225 0 0.0265" rpy="0 0 0" />
    </xacro:inertial_point>
    <visual>
      <origin xyz="${a3/2} 0 0" rpy="0 0 0" />
      <geometry><box size="${-a3} 0.1 0.1" /></geometry>
      <material name="blue" />
    </visual>
    <collision>
      <origin xyz="${a3/2} 0 0" rpy="0 0 0" />
      <geometry><box size="${-a3} 0.1 0.1" /></geometry>
    </collision>
  </link>

  <joint name="arm_joint_4" type="revolute">
    <parent link="arm3" />
    <child link="arm4" />
    <origin xyz="${a3} 0 0" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="${-2*pi}" upper="${2*pi}" velocity="${pi}" effort="120" />
    <dynamics damping="0.1" friction="0.0" />
  </joint>

  <link name="arm4">
    <!-- UR5 ledd 4: 1.219 kg -->
    <xacro:inertial_point mass="1.219">
      <origin xyz="0 0.01634 0.11095" rpy="0 0 0" />
    </xacro:inertial_point>
    <visual>
      <origin xyz="0 0 ${d4/2}" rpy="0 0 0" />
      <geometry><box size="0.1 0.1 ${d4}" /></geometry>
      <material name="blue" />
    </visual>
    <collision>
      <origin xyz="0 0 ${d4/2}" rpy="0 0 0" />
      <geometry><box size="0.1 0.1 ${d4}" /></geometry>
    </collision>
  </link>

  <joint name="arm_joint_5" type="revolute">
    <parent link="arm4" />
    <child link="arm5" />
    <origin xyz="0 0 ${d4}" rpy="${-pi/2} 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="${-2*pi}" upper="${2*pi}" velocity="${pi}" effort="120" />
    <dynamics damping="0.1" friction="0.0" />
  </joint>

  <link name="arm5">
    <!-- UR5 ledd 5: 1.219 kg + ledd 6 (0.1879 kg) -->
    <xacro:inertial_point mass="1.4069">
      <origin xyz="0 -0.0249946 0.0962096" rpy="0 0 0" />
    </xacro:inertial_point>
    <visual>
      <origin xyz="0 0 ${d5/2}" rpy="0 0 0" />
      <geometry><box size="0.07 0.07 ${d5}" /></geometry>
      <material name="blue" />
    </visual>
    <collision>
      <origin xyz="0 0 ${d5/2}" rpy="0 0 0" />
      <geometry><box size="0.07 0.07 ${d5}" /></geometry>
    </collision>
  </link>

  <!-- Dysen er et eget ledd (preserveFixedJoint) slik at vannstrålens kraft kan virke på den.
       Rammen er DH-ramme 9; strålen går langs z. -->
  <joint name="nozzle_fixed" type="fixed">
    <parent link="arm5" />
    <child link="nozzle" />
    <origin xyz="0 0 ${d5}" rpy="${pi/2} 0 0" />
  </joint>

  <link name="nozzle">
    <!-- dyse 3 kg, tyngdepunkt midt på dysen -->
    <xacro:inertial_point mass="3">
      <origin xyz="0 0 0.1573" rpy="0 0 0" />
    </xacro:inertial_point>
    <visual>
      <origin xyz="0 0 ${L_flens/2}" rpy="0 0 0" />
      <geometry><box size="0.075 0.075 ${L_flens}" /></geometry>
      <material name="blue" />
    </visual>
    <visual>
      <origin xyz="0 0 ${L_flens + L_dyse/2}" rpy="0 0 0" />
      <geometry><box size="0.06 0.06 ${L_dyse}" /></geometry>
      <material name="red" />
    </visual>
    <collision>
      <origin xyz="0 0 ${L_flens + L_dyse/2}" rpy="0 0 0" />
      <geometry><box size="0.06 0.06 ${L_dyse}" /></geometry>
    </collision>
  </link>

  <joint name="tcp_fixed" type="fixed">
    <parent link="nozzle" />
    <child link="tcp" />
    <origin xyz="0 0 ${L_flens + L_dyse}" rpy="0 0 0" />
  </joint>

  <link name="tcp" />

  <gazebo reference="nozzle_fixed">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>

</robot>

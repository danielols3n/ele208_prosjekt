<!-- Vegg og 40 N sidekraft ved dysen i Gazebo. -->
<sdf version="1.9">
  <world name="facade">
    <gravity>0 0 -9.81</gravity>
    <physics name="physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
      <engine>
        <filename>gz-physics-bullet-featherstone-plugin</filename>
      </engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <!-- Jeg fikk kodeforslag fra KI til sidekraften i Gazebo og hjelp
         til å sjekke at kraften påføres dysen. -->
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench">
      <persistent>
        <entity_name>lift_window::nozzle</entity_name>
        <entity_type>link</entity_type>
        <force>40 0 0</force>
      </persistent>
    </plugin>
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.78 0.85 0.93 1</background>
      <shadows>false</shadows>
    </scene>
    <light type="directional" name="sun">
      <pose>0 0 12 0 0 0</pose>
      <direction>-0.5 0.3 -1</direction>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <cast_shadows>false</cast_shadows>
    </light>
    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.45 0.48 0.46 1</ambient>
            <diffuse>0.45 0.48 0.46 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="wall">
      <static>true</static>
      <pose>5.0 2.1 5 0 0 0</pose>
      <link name="wall_link">
        <collision name="wall_collision">
          <geometry>
            <box>
              <size>10 0.2 10</size>
            </box>
          </geometry>
        </collision>
        <visual name="wall_visual">
          <geometry>
            <box>
              <size>10 0.2 10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.40 0.65 0.75 1</ambient>
            <diffuse>0.40 0.65 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

function P=visualFramePoints(q,basePosition,ur_d1,ur_a2,ur_a3,ur_d4,ur_d5)

    theta=[q(1),q(2),0,q(4)-pi/2,q(5),q(6),q(7),q(8),q(9)];
    d=[0,0,q(3),0,ur_d1,0,0,ur_d4,ur_d5];
    a=[0,0,0,0,0,ur_a2,ur_a3,0,0];
    alpha=[pi/2,pi/2,pi/2,-pi/2,pi/2,0,0,pi/2,-pi/2];
    T=eye(4); T(1:3,4)=basePosition(:);
    P=zeros(3,10); P(:,1)=T(1:3,4);
    for j=1:9
        ct=cos(theta(j)); st=sin(theta(j));
        ca=cos(alpha(j)); sa=sin(alpha(j));
        A=[ct,-st*ca, st*sa,a(j)*ct; ...
           st, ct*ca,-ct*sa,a(j)*st; ...
            0,    sa,    ca,   d(j); ...
            0,     0,     0,      1];
        T=T*A;
        P(:,j+1)=T(1:3,4);
    end
end



function [traj,mountPath]=commitChunk(traj,mountPath,chunk,cfg)
    if isempty(chunk),return;end
    traj=[traj;chunk]; %#ok<AGROW>
    for i=1:size(chunk,1)
        q=chunk(i,4:12); u=[q(1:3),q(5:9)];
        p=posePosition(cfg.lift,[u(1:3),u(2)]);
        mountPath(end+1,:)=[chunk(i,1:3),p']; %#ok<AGROW>
    end
end

function [chunk,nextU,t,reason]=moveLift(u,mountGoal,id,cfg,t,motionStyle)

    [chunk,nextU,t,reason]=moveLiftDirect(u,mountGoal,id,cfg,t,motionStyle);
    if isempty(reason),return;end
    directReason=reason;
    p0=posePosition(cfg.lift,[u(1:3),u(2)]);
    ySafe=min([cfg.transferClearanceY,p0(2),mountGoal(2)]);
    goals={[p0(1);ySafe;p0(3)], ...
           [mountGoal(1);ySafe;mountGoal(3)], mountGoal(:)};
    testU=u; testT=t; testChunk=zeros(0,15);
    for j=1:numel(goals)
        if norm(goals{j}-posePosition(cfg.lift,[testU(1:3),testU(2)]))<cfg.positionTolerance
            continue;
        end
        [part,newU,newT,stageReason]=moveLiftDirect( ...
            testU,goals{j},id,cfg,testT,motionStyle);
        if ~isempty(stageReason)
            chunk=zeros(0,15);nextU=u;
            reason=sprintf('direct: %s | clearance stage %d: %s', ...
                directReason,j,stageReason);
            return;
        end
        testChunk=[testChunk;part]; %#ok<AGROW>
        testU=newU;testT=newT;
    end
    chunk=testChunk;nextU=testU;t=testT;reason='';
end

function [chunk,nextU,t,reason]=moveLiftDirect(u,mountGoal,id,cfg,t,motionStyle)
    chunk=zeros(0,15); nextU=u; reason='';
    p0=posePosition(cfg.lift,[u(1:3),u(2)]);
    if strcmpi(motionStyle,'cartesian')
        targets=cartesianLine(p0,mountGoal,cfg.liftCartesianStep,cfg.maxCartesianSamples);
    else
        targets=mountGoal(:)';
    end
    for k=1:size(targets,1)
        target=targets(k,:)'; d=target-cfg.basePosition(:);
        seeds=[nextU(1:3); atan2(d(2),d(1)),pi/2,norm(d); ...
            0,3*pi/4,norm(d)];
        [liftU,err,ok]=solveLiftIK(cfg.lift,target,seeds, ...
            cfg.lo(1:3),cfg.hi(1:3),cfg.maxLiftIterations, ...
            cfg.positionTolerance,cfg.maxLiftSeeds);
        if ~ok
            reason=sprintf('IK failed at lift waypoint %d (%.3f m)',k,err); return;
        end
        candidate=[liftU,nextU(4:8)];
        [ok,why]=sweptSafe(nextU,candidate,cfg,0,false);
        if ~ok
            reason=sprintf('lift sweep %d: %s',k,why); return;
        end

        n=numberSweeps(nextU,candidate,cfg);
        for s=1:n
            us=nextU+(candidate-nextU)*(s/n);
            [chunk,t]=addSample(chunk,t,cfg.dt,1,id,cfg.robot,us);
        end
        nextU=candidate;
    end
end

function [chunk,nextU,t,reason]=moveArm(u,goal,phase,id,cfg,t,motionStyle,allowContact,paneID)
    if nargin<9,paneID=0;end
    chunk=zeros(0,15); nextU=u; reason='';
    start=posePosition(cfg.robot,fullQ(u));
    if strcmpi(motionStyle,'cartesian')
        targets=cartesianLine(start,goal,cfg.armCartesianStep,cfg.maxCartesianSamples);
    else
        targets=goal(:)';
    end
    for k=1:size(targets,1)
        target=targets(k,:)';

        trials=[nextU(4:8); ...
                0 -pi/2 pi/2 0 0; ...
                0 -pi/3 pi/2 -pi/2 0; ...
                0 -2*pi/3 pi/3 0 pi/2; ...
                pi/2 -pi/2 pi/2 0 0; ...
                -pi/2 -pi/2 pi/2 0 0];
        ok=false; why='no IK solution'; err=Inf;
        for attempt=1:min(cfg.maxArmCollisionSeeds,size(trials,1))
            [armU,trialErr,ikOK]=solveArmIK(cfg.robot,nextU(1:3), ...
                trials(attempt,:),target,cfg.lo(4:8),cfg.hi(4:8), ...
                cfg.maxArmIterations,cfg.positionTolerance,1);
            err=min(err,trialErr);
            if ~ikOK,continue;end
            candidate=[nextU(1:3),armU];
            [ok,why]=sweptSafe(nextU,candidate,cfg,paneID,allowContact);
            if ok,break;end
        end
        if ~ok
            reason=sprintf('arm waypoint %d rejected after %d seeds: %s (IK error %.3f m)', ...
                k,min(cfg.maxArmCollisionSeeds,size(trials,1)),why,err);
            return;
        end
        n=numberSweeps(nextU,candidate,cfg);
        for s=1:n
            us=nextU+(candidate-nextU)*(s/n);
            if phase==2
                tip=posePosition(cfg.robot,fullQ(us));
                if abs(tip(2)-goal(2))>cfg.surfaceTolerance
                    reason='joint interpolation departed from intended wall standoff';
                    return;
                end
            end
            [chunk,t]=addSample(chunk,t,cfg.dt,phase,id,cfg.robot,us);
        end
        nextU=candidate;
    end
end

function n=numberSweeps(u0,u1,cfg)
    delta=abs(u1-u0);
    delta(3)=0;
    n=max([1,ceil(max(delta)/cfg.sweepAngularStep), ...
        ceil(abs(u1(3)-u0(3))/cfg.sweepExtensionStep)]);
end

function [ok,why]=sweptSafe(u0,u1,cfg,paneID,contactAllowed)
    n=numberSweeps(u0,u1,cfg);
    ok=true; why='';
    for k=0:n
        u=u0+(u1-u0)*(k/n);
        [ok,why]=collisionFree(u,cfg,paneID,contactAllowed);
        if ~ok
            why=sprintf('sample %d/%d: %s',k,n,why); return;
        end
    end
end

function [ok,why]=collisionFree(u,cfg,paneID,contactAllowed)

    ok=false; why='';
    if any(u<cfg.lo-1e-8) || any(u>cfg.hi+1e-8)
        why='Joint limit'; return;
    end
    q=fullQ(u);
    P=visualFramePoints(q,cfg.basePosition,cfg.ur_d1,cfg.ur_a2, ...
        cfg.ur_a3,cfg.ur_d4,cfg.ur_d5);

    endpoints=zeros(3,2,6);
    endpoints(:,:,1)=[P(:,1),P(:,5)];
    for j=1:5
        endpoints(:,:,j+1)=[P(:,4+j),P(:,5+j)];
    end
    radii=[cfg.boomRadius,repmat(cfg.armRadius,1,4),cfg.toolRadius];
    radii=radii+cfg.safetyMargin;
    pane=zeros(1,4);
    if paneID>=1 && paneID<=size(cfg.windows,1)
        pane=cfg.windows(paneID,:);
    end
    for j=1:6
        A=endpoints(:,1,j); B=endpoints(:,2,j); r=radii(j);
        if norm(B-A)<1e-6,continue;end

        ns=max(2,ceil(norm(B-A)/0.035));
        for k=0:ns
            p=A+(B-A)*(k/ns);
            if cfg.checkGroundCollision && ...
                    p(3)<r && p(1)>-0.5 && p(1)<cfg.wallW+0.5
                why=sprintf('link %d near ground',j); return;
            end
            inWall=p(1)>=-r && p(1)<=cfg.wallW+r && ...
                   p(3)>=-r && p(3)<=cfg.wallH+r;
            if ~inWall, continue;end

            finalTool=(j==6 && contactAllowed && paneID>0 && ...
                p(1)>=pane(1)+cfg.frameHalfWidth+r && ...
                p(1)<=pane(1)+pane(3)-cfg.frameHalfWidth-r && ...
                p(3)>=pane(2)+cfg.frameHalfWidth+r && ...
                p(3)<=pane(2)+pane(4)-cfg.frameHalfWidth-r);
            if finalTool
                if p(2)>cfg.contactY+cfg.surfaceTolerance
                    why='Tool tip penetrates glass'; return;
                end
            elseif p(2)>-r
                why=sprintf('link %d intersects glass',j); return;
            end

            if p(2)>-cfg.frameDepth-r
                for w=1:size(cfg.windows,1)
                    win=cfg.windows(w,:);
                    x0=win(1); x1=x0+win(3);
                    z0=win(2); z1=z0+win(4);
                    fw=cfg.frameHalfWidth+r;
                    inRail=(p(1)>=x0-fw && p(1)<=x1+fw && ...
                       p(3)>=z0-fw && p(3)<=z1+fw && ...
                       (abs(p(1)-x0)<=fw || abs(p(1)-x1)<=fw || ...
                        abs(p(3)-z0)<=fw || abs(p(3)-z1)<=fw));
                    if inRail
                        why=sprintf('link %d hits window frame %d',j,w);return;
                    end
                end
            end
        end
    end

    for a=2:6
        for b=a+2:6
            if norm(endpoints(:,2,a)-endpoints(:,1,a))<1e-6 || ...
               norm(endpoints(:,2,b)-endpoints(:,1,b))<1e-6,continue;end
            gap=segmentGap(endpoints(:,1,a),endpoints(:,2,a), ...
                endpoints(:,1,b),endpoints(:,2,b));
            if gap<radii(a)+radii(b)
                why=sprintf('UR5 self-collision links %d/%d',a-1,b-1);return;
            end
        end
    end

    for b=4:6
        gap=segmentGap(endpoints(:,1,1),endpoints(:,2,1), ...
            endpoints(:,1,b),endpoints(:,2,b));
        if gap<radii(1)+radii(b)
            why=sprintf('Boom vs arm link %d',b-1);return;
        end
    end
    ok=true;
end

function d=segmentGap(P0,P1,Q0,Q1)
    % Closest distance between two finite 3D line segments.
    u=P1-P0; v=Q1-Q0; w=P0-Q0;
    a=dot(u,u); b=dot(u,v); c=dot(v,v);
    d0=dot(u,w); e=dot(v,w); D=a*c-b*b;
    sD=D; tD=D;
    if D<1e-12
        sN=0; sD=1; tN=e; tD=c;
    else
        sN=b*e-c*d0; tN=a*e-b*d0;
        if sN<0,sN=0;tN=e;tD=c;
        elseif sN>sD,sN=sD;tN=e+b;tD=c;end
    end
    if tN<0
        tN=0;
        if -d0<0,sN=0;
        elseif -d0>a,sN=sD;
        else,sN=-d0;sD=a;end
    elseif tN>tD
        tN=tD;
        if (-d0+b)<0,sN=0;
        elseif (-d0+b)>a,sN=sD;
        else,sN=-d0+b;sD=a;end
    end
    if abs(sN)<1e-12,sc=0;else,sc=sN/sD;end
    if abs(tN)<1e-12,tc=0;else,tc=tN/tD;end
    d=norm(w+sc*u-tc*v);
end


assert(exist('SerialLink','class') == 8, ...
    'Peter Corke Robotics Toolbox for MATLAB is required.');

motionStyle='cartesian';    
basePosition=[-4 -2 1.5];           
workingStandoff=0.75;              
contactY=0;                        
ur_d1=0.089159; ur_a2=-0.42500; ur_a3=-0.39225;
ur_d4=0.10915; ur_d5=0.09465; 
armPark=[0 -pi/2 pi/2 0 0];

nSpots=20;                         
randomSeed=7;                      
patchWidth=0.50; patchHeight=0.50;
lineSpacing=0.12;                  
paneMargin=0.06;                   
spotPlacement='spread';            


windows=zeros(100,4);
w=0;
for iz=0:9
    for ix=0:9
        w=w+1; windows(w,:)=[ix iz 1 1];
    end
end


fastMode=true;
if fastMode
    maxLiftIterations=65; maxArmIterations=45;
    maxLiftSeeds=2; maxArmSeeds=2;
else
    maxLiftIterations=150; maxArmIterations=120;
    maxLiftSeeds=3; maxArmSeeds=6;
end

positionTolerance=0.015;         
minWallDistance=0.02;            
maxWallDistance=0.25;            
distanceOptions=[0.02 0.05 0.10 0.15 0.20 0.25];

assert(all(distanceOptions>=minWallDistance-1e-10 & ...
    distanceOptions<=maxWallDistance+1e-10), ...
    'All distanceOptions must be between minWallDistance and maxWallDistance.');
distanceOptions=unique(sort(distanceOptions));

liftCartesianStep=0.20;          
armCartesianStep=0.035;          
maxCartesianSamples=2000;       
dt=0.1;
showAnimation=true; playbackPause=0.025; plotEvery=3;
followRadius=1.45; exportCSV=true;
showEntirePath=true;             
retractDistance=0.30;             
frameHalfWidth=0.018;             
frameDepth=0.060;                 
boomRadius=0.065;                
armRadius=0.035;                 
toolRadius=0.012;                
safetyMargin=0.010;              
checkGroundCollision=false;         
sweepAngularStep=0.10;           
sweepExtensionStep=0.10;         
surfaceTolerance=0.015;          


transferClearanceY=-1.30;       
maxArmCollisionSeeds=6;       


assert(nSpots==round(nSpots) && nSpots>=1,'nSpots must be positive integer.');
assert(patchWidth>0 && patchHeight>0 && lineSpacing>0);
assert(size(windows,2)==4 && ~isempty(windows),'windows must be Nx4.');
assert(all(windows(:,3)>2*paneMargin) && all(windows(:,4)>2*paneMargin), ...
    'Each pane must be larger than twice paneMargin.');
assert(all(windows(:,1)>=0) && all(windows(:,2)>=0) && ...
    all(windows(:,1)+windows(:,3)<=wallW+1e-9) && ...
    all(windows(:,2)+windows(:,4)<=wallH+1e-9), ...
    'All panes must fit inside the wall.');


qlim=[-pi pi; 0 pi; 4 18; 0 pi; ...
      -2*pi 2*pi; -2*pi 2*pi; -2*pi 2*pi; -2*pi 2*pi; -2*pi 2*pi];
links(1)=Link([0 0 0 pi/2 0],'standard');
links(2)=Link([0 0 0 pi/2 0],'standard');
links(3)=Link([0 0 0 pi/2 1],'standard');
links(4)=Link([0 0 0 -pi/2 0],'standard');
links(5)=Link([0 ur_d1 0 pi/2 0],'standard');
links(6)=Link([0 0 ur_a2 0 0],'standard');
links(7)=Link([0 0 ur_a3 0 0],'standard');
links(8)=Link([0 ur_d4 0 pi/2 0],'standard');
links(9)=Link([0 ur_d5 0 -pi/2 0],'standard');
links(4).offset=-pi/2;         
for j=1:9, links(j).qlim=qlim(j,:); end
robot=SerialLink(links,'name','Lift + UR5-5axis');
robot.base=transl(basePosition);
lift=SerialLink(links(1:4),'name','Lift');
lift.base=transl(basePosition);
lo=qlim([1 2 3 5 6 7 8 9],1)';
hi=qlim([1 2 3 5 6 7 8 9],2)';

cfg=struct('robot',robot,'lift',lift,'basePosition',basePosition, ...
    'ur_d1',ur_d1,'ur_a2',ur_a2,'ur_a3',ur_a3,'ur_d4',ur_d4,'ur_d5',ur_d5, ...
    'windows',windows,'wallW',wallW,'wallH',wallH, ...
    'frameHalfWidth',frameHalfWidth,'frameDepth',frameDepth, ...
    'boomRadius',boomRadius,'armRadius',armRadius, ...
    'toolRadius',toolRadius,'safetyMargin',safetyMargin, ...
    'checkGroundCollision',checkGroundCollision, ...
    'retractDistance',retractDistance,'surfaceTolerance',surfaceTolerance, ...
    'sweepAngularStep',sweepAngularStep,'sweepExtensionStep',sweepExtensionStep, ...
    'lo',lo,'hi',hi,'positionTolerance',positionTolerance, ...
    'maxLiftIterations',maxLiftIterations,'maxArmIterations',maxArmIterations, ...
    'maxLiftSeeds',maxLiftSeeds,'maxArmSeeds',maxArmSeeds, ...
    'liftCartesianStep',liftCartesianStep,'armCartesianStep',armCartesianStep, ...
    'maxCartesianSamples',maxCartesianSamples,'dt',dt,'contactY',contactY, ...
    'minWallDistance',minWallDistance,'maxWallDistance',maxWallDistance, ...
    'distanceOptions',distanceOptions, ...
    'transferClearanceY',transferClearanceY, ...
    'maxArmCollisionSeeds',maxArmCollisionSeeds);



rng(randomSeed);
nWindows=size(windows,1);
if strcmpi(spotPlacement,'spread')
    paneID=repmat(randperm(nWindows)',ceil(nSpots/nWindows),1);
    paneID=paneID(1:nSpots);
elseif strcmpi(spotPlacement,'random')
    paneID=randi(nWindows,nSpots,1);
else
    error('spotPlacement must be spread or random.');
end
spots=zeros(nSpots,2);             % [X Z]
patches=zeros(nSpots,4);           % [minX maxX minZ maxZ]
for k=1:nSpots
    pane=windows(paneID(k),:);
    xmin=pane(1)+paneMargin; xmax=pane(1)+pane(3)-paneMargin;
    zmin=pane(2)+paneMargin; zmax=pane(2)+pane(4)-paneMargin;
   
    cx0=xmin+patchWidth/2; cx1=xmax-patchWidth/2;
    cz0=zmin+patchHeight/2; cz1=zmax-patchHeight/2;
    if cx0>cx1, cx0=(xmin+xmax)/2; cx1=cx0; end
    if cz0>cz1, cz0=(zmin+zmax)/2; cz1=cz0; end
    cx=cx0+(cx1-cx0)*rand;
    cz=cz0+(cz1-cz0)*rand;
    spots(k,:)=[cx cz];
    patches(k,:)=[max(xmin,cx-patchWidth/2),min(xmax,cx+patchWidth/2), ...
                   max(zmin,cz-patchHeight/2),min(zmax,cz+patchHeight/2)];
end

%% 4. ROUTE: NEAREST-NEIGHBOUR + 2-OPT
% Route cost is planar distance between spot centers; not true joint time.
order=nearestTwoOpt(spots,[basePosition(1) basePosition(3)]);
orderedSpots=spots(order,:);
routeDist=sum(sqrt(sum(diff([[basePosition(1) basePosition(3)];orderedSpots]).^2,2)));
fprintf('Generated %d spots across %d panes; approximate wall route %.2f m.\n', ...
    nSpots,nWindows,routeDist);

%% 5. SHOW PANE LAYOUT AND PLANNED VISIT ORDER
figure('Name','Window spots and visit order','Color','w'); hold on; grid on;
rectangle('Position',[0 0 wallW wallH],'EdgeColor','k','LineWidth',2);
for j=1:nWindows
    rectangle('Position',windows(j,:),'EdgeColor',[0.55 0.67 0.78], ...
        'FaceColor',[0.93 0.97 1]);
end
plot(orderedSpots(:,1),orderedSpots(:,2),'-o','Color',[0.15 0.35 0.85], ...
    'LineWidth',1.5,'MarkerFaceColor',[1 0.55 0.10]);
for k=1:nSpots
    id=order(k); p=patches(id,:);
    rectangle('Position',[p(1) p(3) p(2)-p(1) p(4)-p(3)], ...
        'EdgeColor',[0.15 0.65 0.3],'LineStyle','--');
    text(spots(id,1)+0.04,spots(id,2),num2str(k),'FontSize',8);
end
xlabel('X (m)'); ylabel('Z (m)'); title('Numbered visit order and local cleaning patches');
axis equal; xlim([0 wallW]); ylim([0 wallH]);

%% 6. COLLISION-CHECKED MOTION PLANNING
% phase 1 = lift transfer; phase 2 = cleaning; phase 3 = approach;
% phase 4 = retract; all trajectories saved ONLY if sweep tests pass.
planningTimer=tic;
trajectory=zeros(0,15);
mountPath=zeros(0,6);
complete=false(nSpots,1);
usedWallDistance=nan(nSpots,1); % actual chosen tool-center distance (metres)
failureReason=cell(nSpots,1);
maxTipError=0; time=0;
u=clamp([0 pi/2 4 armPark],lo,hi);
% Check start configuration. Otherwise no motion may be trusted.
[startSafe,startWhy]=collisionFree(u,cfg,0,false);
if ~startSafe
    error('Initial robot configuration is in collision: %s. Choose a valid start pose.',startWhy);
end
aborted=false;
for visit=1:nSpots
    spotID=order(visit); cx=spots(spotID,1); cz=spots(spotID,2);
    % SAFE RETRACTION from previous window location, if necessary.
    tip=posePosition(robot,fullQ(u));
    if tip(2)>-retractDistance+surfaceTolerance
        retreat=[tip(1);-retractDistance;tip(3)];
        [chunk,ui,ti,reason]=moveArm(u,retreat,4,spotID,cfg,time,'cartesian',true);
        if ~isempty(reason)
            failureReason{spotID}=['Cannot retract before lift: ' reason];
            aborted=true; break;
        end
        [trajectory,mountPath]=commitChunk(trajectory,mountPath,chunk,cfg);
        u=ui; time=ti;
    end
    % Move mounting point between spots; hold the five small-arm angles.
    [chunk,ui,ti,reason]=moveLift(u,[cx;-workingStandoff;cz], ...
        spotID,cfg,time,motionStyle);
    if ~isempty(reason)
        failureReason{spotID}=['Lift transfer rejected: ' reason];
        fprintf('Visit %d spot %d: %s\n',visit,spotID,failureReason{spotID});
        % Stop instead of cascading through the remaining spots from an
        % unchanged configuration. A new route requires replanning.
        warning('Stopping after unsafe transfer. No further moves were committed.');
        aborted=true; break;
    end
    [trajectory,mountPath]=commitChunk(trajectory,mountPath,chunk,cfg);
    u=ui; time=ti;

    p=patches(spotID,:);
    raster=verticalRaster(p(1),p(2),p(3),p(4),lineSpacing);
    % Go to first raster point at a clearance depth, THEN approach glass.
    entry=[raster(1,1);-retractDistance;raster(1,2)];
    [chunk,ui,ti,reason]=moveArm(u,entry,3,spotID,cfg,time,'cartesian',false);
    if ~isempty(reason)
        failureReason{spotID}=['Clearance approach rejected: ' reason];
        fprintf('Spot %d: %s\n',spotID,failureReason{spotID});
        continue;
    end
    [trajectory,mountPath]=commitChunk(trajectory,mountPath,chunk,cfg);
    u=ui; time=ti;

    % Try ALL specified wall-distance choices, closest first.
    % Each trial is transactional: the entire approach, raster AND retract
    % must pass IK plus swept collision checks before any trial is saved.
    % A failed trial leaves the robot at the safe clearance entry pose.
    entryU=u;
    entryTime=time;
    reasons=cell(numel(distanceOptions),1);
    for depthIndex=1:numel(distanceOptions)
        depth=distanceOptions(depthIndex);
        trialU=entryU; trialT=entryTime;
        trialChunk=zeros(0,15);
        goal=[raster(1,1);contactY-depth;raster(1,2)];
        [part,newU,newT,reason]=moveArm(trialU,goal,3,spotID,cfg, ...
            trialT,'cartesian',true,paneID(spotID));
        if ~isempty(reason)
            reasons{depthIndex}=sprintf('%.2f m approach: %s',depth,reason);
            continue;
        end
        trialChunk=[trialChunk;part];
        trialU=newU; trialT=newT;
        trialOK=true;
        for seg=2:size(raster,1)
            goal=[raster(seg,1);contactY-depth;raster(seg,2)];
            [part,newU,newT,reason]=moveArm(trialU,goal,2,spotID,cfg, ...
                trialT,motionStyle,true,paneID(spotID));
            if ~isempty(reason)
                reasons{depthIndex}=sprintf('%.2f m stroke %d: %s', ...
                    depth,seg,reason);
                trialOK=false;
                break;
            end
            trialChunk=[trialChunk;part];
            trialU=newU; trialT=newT;
        end
        if ~trialOK, continue; end

        % Finish with a checked retract from the chosen cleaning depth.
        tip=posePosition(robot,fullQ(trialU));
        retreat=[tip(1);-retractDistance;tip(3)];
        [part,newU,newT,reason]=moveArm(trialU,retreat,4,spotID,cfg, ...
            trialT,'cartesian',true,paneID(spotID));
        if ~isempty(reason)
            reasons{depthIndex}=sprintf('%.2f m retract: %s',depth,reason);
            continue;
        end
        trialChunk=[trialChunk;part];
        trialU=newU; trialT=newT;

        % Entire candidate has passed: commit once, never a partial patch.
        [trajectory,mountPath]=commitChunk(trajectory,mountPath,trialChunk,cfg);
        u=trialU; time=trialT;
        usedWallDistance(spotID)=depth;
        complete(spotID)=true;
        fprintf('Spot %d solved at %.2f m from wall.\n',spotID,depth);
        break;
    end
    if ~complete(spotID)
        failureReason{spotID}=strjoin(reasons(~cellfun('isempty',reasons)),' | ');
        fprintf('Spot %d: No full collision-free cleaning sequence found at any wall distance.\n',spotID);
        % Remain at the verified entry configuration; no failed trial was committed.
        u=entryU; time=entryTime;
    end
    fprintf('Visit %d/%d, spot %d: %s\n',visit,nSpots,spotID, ...
        ternary(complete(spotID),'COLLISION-CHECKED COMPLETE','UNSOLVED'));
    if aborted, break; end
end
fprintf('Planning %.2f s; collision-checked completed %d/%d spots.\n', ...
    toc(planningTimer),sum(complete),nSpots);
if aborted
    warning('Planning stopped: tool could not be safely retracted. No unsafe motion was appended.');
end
% Plot every ACTUALLY solved Cartesian tool position and all transfers.
% NaN delimiters stop lines from drawing across failed / skipped spots.
figure('Name','FULL solved Cartesian path on windows','Color','w');
hold on; grid on; axis equal;
rectangle('Position',[0 0 wallW wallH],'EdgeColor','k','LineWidth',2);
for j=1:nWindows
    rectangle('Position',windows(j,:),'EdgeColor',[.70 .75 .80]);
end
plot(orderedSpots(:,1),orderedSpots(:,2),':','Color',[.6 .6 .6], ...
    'LineWidth',1,'DisplayName','Visit order (nominal)');
if ~isempty(trajectory)
    plot(trajectory(:,13),trajectory(:,15),'-','Color',[.76 .76 .76], ...

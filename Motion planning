    plotPhasePath2D(trajectory,1,[.9 .4 .1],1.3,'Lift transfer (tool projection)');
    plotPhasePath2D(trajectory,2,[.02 .54 .26],1.6,'Cartesian cleaning strokes');
    plotPhasePath2D(trajectory,3,[.55 .25 .80],1.3,'Tool approach');
    plotPhasePath2D(trajectory,4,[.65 .17 .55],1.3,'Tool retract');
end
scatter(spots(:,1),spots(:,2),32,[.7 .1 .1],'filled', ...
    'DisplayName','Target spots');
for k=1:nSpots
    text(spots(order(k),1)+.045,spots(order(k),2),num2str(k),'FontSize',8);
end
xlim([0 wallW]); ylim([0 wallH]);
xlabel('Wall X (m)'); ylabel('Wall Z (m)');
title('Validated sampled route: transfers, approaches, retracts and cleaning');
legend('Location','eastoutside');

% A second plot shows the actual 3D tool trajectory as well as the lift
% mount position, including the depth dimension in front of the wall.
figure('Name','Full 3D Cartesian paths','Color','w'); hold on; grid on;
if ~isempty(trajectory)
    plot3(trajectory(:,13),trajectory(:,14),trajectory(:,15), ...
        '-','Color',[.76 .76 .76],'LineWidth',.6, ...
        'DisplayName','Entire sampled tool trace');
    plotPhasePath3D(trajectory,1,[.9 .4 .1],1.2,'Tool during lift transfer');
    plotPhasePath3D(trajectory,2,[.02 .54 .26],1.6,'Tool during cleaning');
    plotPhasePath3D(trajectory,3,[.55 .25 .80],1.3,'Tool approach');
    plotPhasePath3D(trajectory,4,[.65 .17 .55],1.3,'Tool retract');
end
if ~isempty(mountPath)
    plot3(mountPath(:,4),mountPath(:,5),mountPath(:,6), ...
        'Color',[.25 .45 .85],'LineWidth',1.0,'DisplayName','Lift mount path');
end
xlabel('X (m)');ylabel('Y (m)');zlabel('Z (m)');axis equal;
view(40,20); legend('Location','best');
title('Collision-checked FK trace of tool and lift mount');

%% 7. RESULTS AND CSV OUTPUTS
figure('Name','Spot cleaning result','Color','w'); hold on; grid on;
rectangle('Position',[0 0 wallW wallH],'EdgeColor','k','LineWidth',2);
for j=1:nWindows
    rectangle('Position',windows(j,:),'EdgeColor',[0.65 0.75 0.83]);
end
for k=1:nSpots
    p=patches(k,:);
    if complete(k), c=[0.80 0.94 0.80]; else, c=[1 0.78 0.78]; end
    rectangle('Position',[p(1) p(3) p(2)-p(1) p(4)-p(3)], ...
        'FaceColor',c,'EdgeColor',[0.35 0.5 0.35]);
end
if ~isempty(trajectory)
    rows=trajectory(:,2)==2;
    plot(trajectory(rows,13),trajectory(rows,15),'.','Color',[0.1 0.3 0.8], ...
        'MarkerSize',5);
end
plot(orderedSpots(:,1),orderedSpots(:,2),'k.');
axis equal; xlim([0 wallW]); ylim([0 wallH]);
xlabel('X (m)'); ylabel('Z (m)');
title(sprintf('Planned cleaning: %d/%d patches solved (red=incomplete)',sum(complete),nSpots));
for k=1:nSpots
    if complete(k)
        text(spots(k,1)+0.06,spots(k,2),sprintf('%.0f cm',100*usedWallDistance(k)), ...
            'FontSize',7,'Color',[0.05 0.4 0.12]);
    end
end

if exportCSV
    visitNumber=zeros(nSpots,1); visitNumber(order)=1:nSpots;
    spotTable=table((1:nSpots)',paneID,visitNumber,spots(:,1),spots(:,2), ...
        patches(:,1),patches(:,2),patches(:,3),patches(:,4),complete, ...
        usedWallDistance, ...
        failureReason,'VariableNames', ...
        {'spot_id','pane_id','visit_order','x_m','z_m','x_min','x_max', ...
        'z_min','z_max','planned_complete','wall_distance_m','failure_reason'});
    writetable(spotTable,'window_spots_route_collision.csv');
    if ~isempty(mountPath)
        writetable(array2table(mountPath,'VariableNames', ...
          {'time_s','phase','spot_id','mount_x_m','mount_y_m','mount_z_m'}), ...
          'window_lift_mount_collision.csv');
    end
    if ~isempty(trajectory)
        names={'time_s','phase','spot_id','q1_rad','q2_rad','d3_m', ...
            'q4_rad','q5_rad','q6_rad','q7_rad','q8_rad','q9_rad', ...
            'tool_x_m','tool_y_m','tool_z_m'};
        writetable(array2table(trajectory,'VariableNames',names), ...
            'window_spot_collision_trajectory.csv');
    end
end

if showAnimation && ~isempty(trajectory)
    playRobotViews(trajectory,basePosition,ur_d1,ur_a2,ur_a3,ur_d4,ur_d5, ...
        wallW,wallH,plotEvery,playbackPause,followRadius,showEntirePath);
end

%% HELPER FUNCTIONS FOR CARTESIAN PATH MARKING
function points=cartesianLine(p0,p1,step,maxSamples)
    p0=p0(:); p1=p1(:);
    count=max(1,ceil(norm(p1-p0)/step));
    assert(count<=maxSamples,'Cartesian segment too long. Increase step.');
    alpha=(1:count)'/count;
    points=p0'+alpha*(p1-p0)'; % EXCLUDES p0; INCLUDES p1
end

function plotPhasePath2D(traj,phase,color,width,name)
    inds=find(traj(:,2)==phase);
    if isempty(inds),return;end
    starts=[true;diff(inds)>1 | diff(traj(inds,3))~=0];
    x=traj(inds,13); z=traj(inds,15);
    breaks=starts & ((1:numel(inds))'>1);
    x(breaks)=NaN; z(breaks)=NaN;
    plot(x,z,'Color',color,'LineWidth',width,'DisplayName',name);
end

function plotPhasePath3D(traj,phase,color,width,name)
    inds=find(traj(:,2)==phase);
    if isempty(inds),return;end
    x=traj(inds,13); y=traj(inds,14); z=traj(inds,15);
    breaks=[false;diff(inds)>1 | diff(traj(inds,3))~=0];
    x(breaks)=NaN; y(breaks)=NaN; z(breaks)=NaN;
    plot3(x,y,z,'Color',color,'LineWidth',width,'DisplayName',name);
end

function plotPhasePath3DAxes(ax,traj,phase,color,width)
    inds=find(traj(:,2)==phase);
    if isempty(inds),return;end
    x=traj(inds,13); y=traj(inds,14); z=traj(inds,15);
    breaks=[false;diff(inds)>1 | diff(traj(inds,3))~=0];
    x(breaks)=NaN; y(breaks)=NaN; z(breaks)=NaN;
    plot3(ax,x,y,z,'Color',color,'LineWidth',width);
end

%% LOCAL FUNCTIONS
function out=ternary(cond,a,b)
    if cond, out=a; else, out=b; end
end

function out = clamp(v,lo,hi)
    out = min(max(v,lo),hi);
end

function q = fullQ(u)
    % u = [q1 q2 d3 UR5_J1 UR5_J2 UR5_J3 UR5_J4 UR5_J5].
    % q4=q2 (offset -pi/2 is included in Link 4).
    q=[u(1),u(2),u(3),u(2),u(4:8)];
end

function p = posePosition(robot,q)
    T=robot.fkine(q);
    % Modern Peter Corke RTB returns an SE3; some versions return 4x4.
    if isa(T,'SE3'), M=T.T; else, M=double(T); end
    p=M(1:3,4);
end

function [v,err,ok] = solveLiftIK(lift,target,seeds,lo,hi,maxIter,tol,maxSeeds)
    % qLift = [q1 q2 d3 q2]; fourth joint follows second.
    bestErr=Inf; v=clamp(seeds(1,:),lo,hi);
    for s=1:min(size(seeds,1),maxSeeds)
        z=clamp(seeds(s,:),lo,hi);
        for i=1:maxIter
            q=[z(1),z(2),z(3),z(2)];
            p=posePosition(lift,q);
            e=target-p;
            if norm(e)<tol, break; end
            J=lift.jacob0(q);
            J3=[J(1:3,1),J(1:3,2)+J(1:3,4),J(1:3,3)];
            lambda=0.08;
            dz=J3' * ((J3*J3'+lambda^2*eye(3))\e);
            % Limit per-iteration moves (radians for rotations, m for d3).
            dz = max(min(dz,[0.15;0.15;0.30]),[-0.15;-0.15;-0.30]);
            z=clamp(z+dz',lo,hi);
        end
        errNow=norm(target-posePosition(lift,[z(1:3),z(2)]));
        if errNow<bestErr, bestErr=errNow; v=z; end
        if errNow<tol, break; end
    end
    err=bestErr; ok=(err<tol);
end

function [v,err,ok] = solveArmIK(robot,liftU,previous,target,lo,hi,maxIter,tol,maxSeeds)

    seeds = [previous; ...
             0 -pi/2 pi/2 0 0; ...
             0 -pi/3 pi/2 -pi/2 0; ...
             0 -2*pi/3 pi/3 0 pi/2; ...
             pi/2 -pi/2 pi/2 0 0; ...
             -pi/2 -pi/2 pi/2 0 0];
    bestErr=Inf; v=previous;
    for s=1:min(size(seeds,1),maxSeeds)
        z=clamp(seeds(s,:),lo,hi);
        for i=1:maxIter
            q=fullQ([liftU,z]);
            p=posePosition(robot,q);
            e=target-p;
            if norm(e)<tol, break; end
            J=robot.jacob0(q);
            J5=J(1:3,5:9);
            lambda=0.06;
            dz=J5'*((J5*J5'+lambda^2*eye(3))\e);
            dz=max(min(dz,0.18),-0.18);
            z=clamp(z+dz',lo,hi);
        end
        errNow=norm(target-posePosition(robot,fullQ([liftU,z])));
        if errNow<bestErr, bestErr=errNow; v=z; end
        if errNow<tol, break; end
    end
    err=bestErr; ok=(err<tol);
end

function path=verticalRaster(x0,x1,z0,z1,pitch)
    % Vertical up/down zig-zag INSIDE the spot's clipped cleaning rectangle.
    nCols=max(2,ceil((x1-x0)/pitch)+1);
    xs=linspace(x0,x1,nCols);
    path=zeros(2*nCols,2);
    for k=1:nCols
        ii=2*k-1;
        if mod(k,2)==1
            path(ii:ii+1,:)=[xs(k) z0; xs(k) z1];
        else
            path(ii:ii+1,:)=[xs(k) z1; xs(k) z0];
        end
    end
end

function order=nearestTwoOpt(points,startAt)
    n=size(points,1);
    remaining=true(n,1); order=zeros(n,1); last=startAt;
    for k=1:n
        distances=sum((points-last).^2,2);
        distances(~remaining)=Inf;
        [~,idx]=min(distances);
        order(k)=idx;
        remaining(idx)=false;
        last=points(idx,:);
    end
    if n>2
        for pass=1:8
            improved=false;
            for a=1:n-1
                for b=a+1:n
                    if a==1, before=startAt; else, before=points(order(a-1),:); end
                    if b==n
                        old=norm(before-points(order(a),:));
                        new=norm(before-points(order(b),:));
                    else
                        after=points(order(b+1),:);
                        old=norm(before-points(order(a),:)) + ...
                            norm(points(order(b),:)-after);
                        new=norm(before-points(order(b),:)) + ...
                            norm(points(order(a),:)-after);
                    end
                    if new < old-1e-9
                        order(a:b)=flipud(order(a:b));
                        improved=true;
                    end
                end
            end
            if ~improved, break; end
        end
    end
end

function [data,t] = addSample(data,t,dt,phase,tile,robot,u)
    q=fullQ(u);
    p=posePosition(robot,q);
    t=t+dt;
    data(end+1,:)=[t,phase,tile,q,p'];
end


